{
  "owner": "tester",
  "status": "alpha",
  "support": "support-team",
  "definition": {
    "job_type": "sample_wap_static",
    "step_type": "template",
    "version": "v1",
    "description": "Audit and publish a snapshot. The workflow attaches its write steps at the writes position and may attach steps after the publish.",
    "params": {
      "table": {
        "type": "STRING",
        "value": ""
      },
      "snapshot": {
        "type": "STRING",
        "mode": "IMMUTABLE",
        "expression": "publish__snapshot;",
        "source": "TEMPLATE_OUTPUT"
      },
      "rows": {
        "type": "LONG",
        "mode": "IMMUTABLE",
        "expression": "audit__total;",
        "source": "TEMPLATE_OUTPUT"
      }
    },
    "prepare": {
      "type": "static",
      "steps": [
        {
          "step": {
            "id": "audit",
            "type": "NoOp",
            "params": {
              "total": {
                "type": "LONG",
                "expression": "long t = 0; for (int i = 0; i < writes__row_count.length; i += 1) { t = t + writes__row_count[i]; } return t;"
              }
            },
            "transition": {
              "successors": {
                "publish": "true"
              }
            }
          }
        },
        {
          "step": {
            "id": "publish",
            "type": "NoOp",
            "params": {
              "snapshot": {
                "type": "STRING",
                "expression": "'snapshot-' + table;"
              }
            }
          }
        }
      ]
    },
    "step_inputs": {
      "writes": {
        "successors": [
          "audit"
        ],
        "params": [
          "table"
        ],
        "outputs": {
          "row_count": {
            "type": "LONG"
          }
        }
      },
      "after_publish": {
        "predecessors": [
          "publish"
        ],
        "params": [
          "table",
          "snapshot"
        ]
      }
    }
  }
}
