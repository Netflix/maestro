{
  "template": {
    "id": "publish",
    "sub_type": "write_audit_publish",
    "sub_type_version": "v3",
    "transition": {
      "successors": {
        "notify": "true"
      }
    },
    "params": {
      "target_table": {
        "value": "core.trips",
        "type": "STRING"
      },
      "snapshot_id": {
        "expression": "return UUID.randomUUID().toString();",
        "type": "STRING"
      }
    },
    "step_inputs": {
      "writes": [
        {
          "step": {
            "id": "write_a",
            "type": "NoOp",
            "transition": {
              "successors": {
                "write_b": "true"
              }
            },
            "params": {
              "row_count": {
                "value": 0,
                "type": "LONG",
                "mode": "MUTABLE"
              }
            }
          }
        },
        {
          "step": {
            "id": "write_b",
            "type": "NoOp",
            "params": {
              "row_count": {
                "value": 0,
                "type": "LONG",
                "mode": "MUTABLE"
              }
            }
          }
        }
      ],
      "after_publish": [
        {
          "step": {
            "id": "announce",
            "type": "NoOp",
            "params": {
              "msg": {
                "expression": "'published ' + published_snapshot;",
                "type": "STRING"
              }
            }
          }
        }
      ]
    }
  }
}
